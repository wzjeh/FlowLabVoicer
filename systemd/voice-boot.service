[Unit]
Description=Voice Assistant Boot Greeter (LED + chime)
# user-mode service — runs inside the user's systemd --user instance, so it
# automatically inherits XDG_RUNTIME_DIR and the running PipeWire session.
# Requires `loginctl enable-linger wyzhaoc` (one-time) so the user session
# starts at boot regardless of console / SSH login.
After=pipewire.socket pipewire.service sound.target
Wants=pipewire.socket

[Service]
Type=oneshot
WorkingDirectory=/home/wyzhaoc/voice
ExecStart=/home/wyzhaoc/voice/.venv/bin/python /home/wyzhaoc/voice/bin/boot_greeter.py
RemainAfterExit=no
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
